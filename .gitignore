# SECRETS — never commit. Holds a live Anthropic API key.
Claude API/
**/API.txt

node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
!.env.example

# TypeScript incremental build info
*.tsbuildinfo

# Local HTTPS certificates (WP-31). Private keys, and machine-specific anyway —
# they name this computer's LAN address and are signed by its own root CA.
web/certs/

# vite-plugin-pwa generated output
web/dev-dist/
web/public/sw.js
web/public/workbox-*.js

# Source material — large binaries / copyrighted. Kept on disk, out of history.
#
# Anchored with a leading slash, and it matters. A bare `books/` matches a
# directory of that name at ANY depth, which silently swallowed `api/books/` —
# the Google Books endpoint committed clean, deployed to nothing, and answered
# 404. Only the two directories at the repo root are source material.
/books/
/research-paper/

# Python scratch
__pycache__/
*.pyc

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
