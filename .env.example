# Copy this file to .env and fill in the real values.
# .env itself is gitignored — it never gets committed. This file (.env.example)
# is the only one that is, so anyone setting up the project knows what to fill in.
#
# Setting the cloud backend up from scratch: docs/cloud-setup.md

# --- The tutor (OpenRouter) ---------------------------------------------------
# Server-side only. Held by api/tutor.ts so the key never reaches the browser.
#
# Every model goes through OpenRouter's OpenAI-compatible endpoint, including
# Claude. That is the point: the model is a setting, not an integration, and
# switching one for another costs a slug and nothing else.
#
# Get a key at https://openrouter.ai/keys.

OPENROUTER_API_KEY=

# The fallback chain, most wanted first, comma separated. OpenRouter walks it
# when a model is rate-limited or down, so there is no retry loop in our code.
#
# Left empty, the relay uses `openrouter/free`, which auto-routes to whatever
# free model is up. That is a fine last entry and a poor only entry, because it
# gives up any choice of voice.
#
# THE FREE ROSTER CHURNS WEEKLY. Models are delisted without warning. That is
# why this is an environment variable: a dead slug is a dashboard edit, not a
# deploy. Every entry must be tool-capable, or web search breaks on failover.
#
# Left empty, the relay uses four named free models. Do not put `openrouter/free`
# here. It auto-routes across every free model, coding agents and safety
# classifiers included, and those answer a reading question in the wrong genre
# without ever returning an error.

TUTOR_MODELS=

# The paid Claude slug the model picker offers. Same path, same key, real money.
# Leave it unset until the OpenRouter account has credits. Set with no credits,
# the picker offers a row that returns 402 on every question.

TUTOR_MODEL_CLAUDE=

# How OpenRouter attributes this app's usage. Not a secret. Optional.

TUTOR_REFERER=

# --- Google Books (the catalogue metadata) ------------------------------------
# Server-side only, read by api/. Fills in what a book's own file doesn't say —
# page count, genre, subjects, the public rating — keyed on the ISBN the epub
# already carries.
#
# NEVER prefix this with VITE_, for the same reason as the R2 credentials below:
# the prefix bakes the value into the JavaScript every visitor downloads, and a
# Google API key in public hands is someone else's quota spent on your project.
#
# Get one at https://console.cloud.google.com — create or pick a project,
# APIs & Services → Library → enable "Books API", then Credentials → Create
# credentials → API key. Restrict it to the Books API while you're there;
# unrestricted keys are the ones that get abused.
#
# Technically optional: the Books API answers unauthenticated requests too. In
# practice it is not, because that allowance is counted **per IP address**, and
# a serverless function's IP is shared with every other tenant on the host — so
# production hits HTTP 429 as a matter of course rather than as an edge case.
# This was not a guess: an unauthenticated lookup from this project got a 429
# on the first try.

GOOGLE_BOOKS_KEY=

# --- Supabase (the book records) ----------------------------------------------
# These two are compiled into the browser bundle by Vite and are PUBLIC by
# design. That is safe: the anon key identifies the project, not a person, and
# every table has Row Level Security that matches rows against the signed-in
# user. Signed out, the whole database reads as empty.
#
# Never put the service_role / secret key here. It bypasses those policies
# entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (the files and pictures) -----------------------------------
# Server-side only, read by api/r2/sign.ts. R2 credentials are all-or-nothing —
# anyone holding them can read, overwrite and delete every object in the bucket.
#
# NEVER prefix any of these with VITE_. The prefix is not a naming convention:
# it is an instruction to Vite to bake the value into the JavaScript every
# visitor downloads.

R2_ACCOUNT_ID=
R2_BUCKET=reading-buddy
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The signing endpoint verifies the caller's Supabase session against Supabase
# itself, so it needs the same two public values — without the VITE_ prefix,
# because this copy is read on the server.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed when the app and the API run on different origins — i.e. `vercel
# dev` alongside the Vite server. Comma-separated. In production they share an
# origin and this stays empty.

ALLOWED_ORIGINS=

# Only needed if the signing endpoint isn't at /api/r2/sign on the same origin.

VITE_R2_SIGN_URL=

# The Google Books key, used to fill in publisher, page count, categories,
# ratings and covers. Server-side only: NEVER give this a VITE_ prefix, which
# would compile it into every visitor's JavaScript, one "view source" away from
# strangers spending this project's quota. It reaches Google only through
# api/books/google.ts.

GOOGLE_BOOKS_KEY=

# Only needed if that endpoint isn't at /api/books/google on the same origin.

VITE_BOOKS_URL=
